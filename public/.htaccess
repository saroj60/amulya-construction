<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable directory indexing (prevents 403 Forbidden on folder visits)
  Options -Indexes

  # Forward Authorization header to PHP for JWT authentication
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Route all /api/* requests to the Hostinger MySQL API handler
  RewriteRule ^api/(.*)$ /api/index.php [QSA,L]

  # Serve existing physical files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If a directory without an index.html is requested, rewrite to /index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ /index.html [L]

  # Fallback for all React Router SPA paths
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>
